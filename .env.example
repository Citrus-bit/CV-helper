# Upload and demo analysis require the provider gateway. Put AI_API_KEY only in
# the Git-ignored .env.local file or in a deployment-side server secret.
AI_PROVIDER=provider_gateway
AI_API_BASE=https://yunwu.ai/v1
AI_MODEL=gpt-5.5
AI_RATE_LIMIT_ANALYSIS_PER_HOUR=10
AI_RATE_LIMIT_JD_PER_HOUR=20
AI_RATE_LIMIT_INTERVIEW_PER_HOUR=60
TRUST_PROXY_HEADERS=false
OCR_PROVIDER=baseline
SPEECH_PROVIDER=browser
DATA_RETENTION_HOURS=24
TYPST_BIN=.tools/typst/typst
